{
  "schemaVersion": 1,
  "id": "zombifiedpiglinpatch",
  "version": "${version}",
  "name": "ZombifiedPiglinPatch",
  "description": "Brings back the old zombified piglin behavior: they drop XP no matter how they die, and they no longer spawn with spears.",
  "authors": [
    "DungeonHD a.k.a DungeonFinder"
  ],
  "contact": {},
  "license": "GPL-3.0",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "net.dungeonhd.zombifiedpiglinpatch.client.ZombifiedpiglinpatchDataGenerator"
    ],
    "main": [
      "net.dungeonhd.zombifiedpiglinpatch.Zombifiedpiglinpatch"
    ]
  },
  "mixins": [
    "zombifiedpiglinpatch.mixins.json",
    {
      "config": "zombifiedpiglinpatch.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
